[[ $- == *i* ]] || return 0
[[ -n ${_CCS_SHELL_INIT_DONE-} ]] && return 0
_CCS_SHELL_INIT_DONE=1

ccs() {
  case "$1" in
    use)    shift; eval "$(command ccs __shell_use "$@")" ;;
    unuse)  eval "$(command ccs __shell_unuse)" ;;
    *)      command ccs "$@" ;;
  esac
}

_ccs_hook() {
  [ -n "$CCS_DISABLE_HOOK" ] && return
  eval "$(command ccs __shell_hook 2>/dev/null)"
}

typeset -ga precmd_functions
(( ${precmd_functions[(Ie)_ccs_hook]} )) || precmd_functions+=(_ccs_hook)
